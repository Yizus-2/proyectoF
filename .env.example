# Base de Datos PostgreSQL Local
POSTGRES_DB=essmar_sigvi
POSTGRES_USER=essmar_app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO
POSTGRES_PORT=5432
DATABASE_URL=postgres://essmar_app:CAMBIAR_PASSWORD_SEGURO@127.0.0.1:5432/essmar_sigvi

# Object Storage S3 / MinIO Local (compatible 100% con AWS S3 / R2)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=essmar-sigvi
S3_ACCESS_KEY=CAMBIAR_ACCESS_KEY
S3_SECRET_KEY=CAMBIAR_SECRET_KEY
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Backend API Express
API_PORT=3001
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_64_CHARS
CORS_ORIGIN=http://localhost:5173

# Semilla inicial de cuentas (solo desarrollo local - rotar en producción)
SEED_ADMIN_EMAIL=admin@essmar.gov.co
SEED_ADMIN_PASSWORD=CAMBIAR_ADMIN_PASS
SEED_SUPERVISOR_EMAIL=supervisor@essmar.gov.co
SEED_SUPERVISOR_PASSWORD=CAMBIAR_SUPERVISOR_PASS
SEED_OPERATOR_PASSWORD=CAMBIAR_OPERATOR_PASS

# Frontend Vite (opcional si se usa el proxy por defecto /api)
VITE_API_BASE_URL=
