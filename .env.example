# Semilla inicial de cuentas (solo desarrollo local - rotar en producción)
SEED_ADMIN_EMAIL=admin@essmar.gov.co
SEED_ADMIN_PASSWORD=CAMBIAR_ADMIN_PASS
SEED_SUPERVISOR_EMAIL=supervisor@essmar.gov.co
SEED_SUPERVISOR_PASSWORD=CAMBIAR_SUPERVISOR_PASS
